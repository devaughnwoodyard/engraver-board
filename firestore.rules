rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Managers (event setup) = signed in with Google, verified email, and listed in /staff/{email}.
    // /staff docs are managed in the Firebase console only.
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/staff/$(request.auth.token.email));
    }

    match /staff/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false;
    }

    // The staff PIN, same for every event. Only managers see or change it.
    match /private/{docId} {
      allow read, write: if isStaff();
    }

    // Shared catalog (categories, pieces, options): everyone reads it, managers edit it.
    match /config/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Example photo library (small JPEGs stored inline), shown to guests at every event.
    match /photos/{key} {
      allow read: if true;
      allow create, update: if isStaff() && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow delete: if isStaff();
    }

    // Event setup (items, options, staff names): public read so the guest form and staff sign-in can render.
    match /events/{eventId} {
      // The practice event: anyone with the link can work its board and reset its orders, no sign-in.
      function isDemo() { return eventId == 'demo' && request.auth != null; }
      // Event staff: this device signed in to this event with its PIN (see staffSessions below).
      function isEventStaff() {
        return request.auth != null
          && exists(/databases/$(database)/documents/events/$(eventId)/staffSessions/$(request.auth.uid));
      }
      function canWork() { return isStaff() || isDemo() || isEventStaff(); }

      allow read: if true;
      allow write: if isStaff();

      // One doc per signed-in staff device. Creating it proves the PIN: the PIN sent must match
      // and the event must be open. A name, if sent, must be one of the event's staff names.
      match /staffSessions/{uid} {
        allow read: if (request.auth != null && request.auth.uid == uid) || isStaff();
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'pin', 'at'])
          && request.resource.data.pin == get(/databases/$(database)/documents/private/access).data.pin
          && get(/databases/$(database)/documents/events/$(eventId)).data.get('open', true) != false
          && (!('name' in request.resource.data) || request.resource.data.name in get(/databases/$(database)/documents/events/$(eventId)).data.engravers);
        allow delete: if (request.auth != null && request.auth.uid == uid) || isStaff();
      }

      // Public docs: the queue snapshot the board maintains (so guests see their position)
      // and the event's branding images (managers only).
      match /public/{docId} {
        allow read: if true;
        allow write: if isStaff() || (docId == 'queue' && canWork());
        // A guest may add only their own new order to the bottom of the line, in the same batch that creates it.
        allow create, update: if docId == 'queue' && request.auth != null
          && request.resource.data.keys().hasOnly(['ids', 'updatedAt'])
          && request.resource.data.ids.size() == (resource == null ? 0 : resource.data.ids.size()) + 1
          && (resource == null || request.resource.data.ids.hasAll(resource.data.ids))
          && getAfter(/databases/$(database)/documents/events/$(eventId)/orders/$(request.resource.data.ids[request.resource.data.ids.size() - 1])).data.uid == request.auth.uid;
      }

      match /orders/{orderId} {
        // Guests: create one order as themselves, landing in the queue.
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'queue'
          && request.resource.data.engraver == null
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40;
        // Guests read only their own order; staff read everything at their event.
        allow read: if canWork()
          || (request.auth != null && resource.data.uid == request.auth.uid);
        // Staff move cards; only managers (and the demo) delete them.
        allow update: if canWork();
        allow delete: if isStaff() || isDemo();
      }
    }
  }
}
